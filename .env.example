# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Split frontend/backend deployment (e.g. Netlify + Render) ---

# VITE_API_BASE_URL: set on the FRONTEND build only, when the client and the API server
# are deployed to different origins. Leave unset when they share one origin (local dev,
# or a single combined deployment) — every /api/* call then just stays same-origin.
# VITE_API_BASE_URL="https://your-backend.onrender.com"

# DATA_DIR: set on the BACKEND only, to a mounted persistent disk's path (e.g. Render's
# paid plans mount one at /var/data) so the sync store survives deploys/restarts. Leave
# unset to use the working directory (fine for local dev; NOT durable on hosts with an
# ephemeral filesystem, like a free-tier web service).
# DATA_DIR="/var/data"

# ALLOWED_ORIGIN: set on the BACKEND to your deployed frontend's exact origin (e.g.
# https://your-site.netlify.app) to restrict CORS to just that site. Leave unset to
# allow any origin — fine for a personal app with no cookies/credentials involved.
# ALLOWED_ORIGIN="https://your-site.netlify.app"
